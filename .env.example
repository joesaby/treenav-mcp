# Path to your markdown repository root
DOCS_ROOT=./docs

# Multiple weighted collections (overrides DOCS_ROOT when set)
# Each entry is path[:weight]; collection name = folder basename
# DOCS_ROOTS=./docs:1.0,./api-specs:0.8,./rfcs:0.5

# Glob pattern for finding markdown files
# (comma-separated for multi-glob, e.g. **/*.md,**/*.csv,**/*.jsonl)
DOCS_GLOB=**/*.md

# Max chars indexed per text field in CSV/JSONL rows
# CSV_MAX_TEXT_LENGTH=2000

# Maximum heading depth to index (1-6)
MAX_DEPTH=6

# Characters to include in node summaries
SUMMARY_LENGTH=200

# Port for HTTP transport (serve:http only)
PORT=3100

# Path to glossary JSON for query expansion (default: $DOCS_ROOT/glossary.json)
# GLOSSARY_PATH=./glossary.json

# ── Code navigation (optional) ──────────────────────────────────────
# Set CODE_ROOT to enable AST-based code indexing alongside docs
# CODE_ROOT=./src

# Name for the code collection
# CODE_COLLECTION=code

# Score multiplier for code results vs docs results
# CODE_WEIGHT=1.0

# Glob pattern for code files (default: all supported extensions)
# CODE_GLOB=**/*.{ts,tsx,py,go,rs}
