    "bun": ">=1.3.8"
  },
  "bin": {
    "treenav": "bin.ts"
  },
  "files": [
    "src/",
    "bin.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "serve": "bun run src/server.ts",
    "serve:http": "bun run src/server-http.ts",
    "index": "bun run src/cli-index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
